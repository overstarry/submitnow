# -----------------------------------------------------------------------------
# Site info
# -----------------------------------------------------------------------------
# Set to your production site URL (e.g. https://www.submitnow.dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LOCALE_DETECTION=false
NEXT_PUBLIC_OPTIMIZED_IMAGES=false

# -----------------------------------------------------------------------------
# Analytics
# Google Analytics: https://analytics.google.com/analytics/web/
# Baidu Tongji: https://tongji.baidu.com/
# Plausible: https://plausible.io/
# -----------------------------------------------------------------------------
# Domain should be your site domain (e.g. submitnow.dev)
NEXT_PUBLIC_GOOGLE_ID=
NEXT_PUBLIC_BAIDU_TONGJI=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted script src (defaults to https://plausible.io/js/script.js in code)
NEXT_PUBLIC_PLAUSIBLE_SRC=

#------------------------------------------------------------------------
# Ads
# Google Adsense: https://www.google.com/adsense/
#------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

#------------------------------------------------------------------------
# Resend: https://resend.com/
#------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_EMAIL=
# Optional HMAC secret for signing newsletter unsubscribe tokens (falls back to RESEND_API_KEY)
UNSUBSCRIBE_SECRET=

#------------------------------------------------------------------------
# Upstash: https://upstash.com/
#------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAY_MAX_SUBMISSIONS=
# Optional per-10-minute rate limits for IndexNow actions
INDEXNOW_SUBMIT_RATE_LIMIT=30
KEY_CHECK_RATE_LIMIT=60
SITEMAP_FETCH_RATE_LIMIT=20
